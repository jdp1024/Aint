// ain_wcx.rc
#include "resource.h"
#define APSTUDIO_HIDDEN_SYMBOLS
#include <windows.h>
#include <commctrl.h>
#include <richedit.h>
#undef APSTUDIO_HIDDEN_SYMBOLS
#pragma code_page(65001) // UTF-8

LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT

IDD_CONFIG DIALOGEX 0, 0, 269, 74
CAPTION "AIN packer configuration"
STYLE DS_MODALFRAME | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg 2", 0, 0, 1
{
    LTEXT "Compression:", -1, 7, 6, 53, 8
    COMBOBOX IDC_METHOD, 65, 5, 160, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT "Volume size:", -1, 7, 20, 54, 8
    EDITTEXT IDC_VOLUME, 65, 19, 80, 10, ES_NUMBER
    LTEXT "(size in kb, 0=whole)", -1, 148, 19, 114, 8
    LTEXT "Worker threads:", -1, 7, 34, 54, 12
    EDITTEXT IDC_THREADS, 65, 34, 80, 10, ES_NUMBER
    LTEXT "(0=automatic; 1..256=explicit)", -1, 148, 35, 113, 9
    DEFPUSHBUTTON "OK", IDOK, 159, 52, 50, 16
    PUSHBUTTON "Cancel", IDCANCEL, 211, 52, 50, 16
    LTEXT "AINT - A modern AIN archiver by jdp1024", -1, 7, 56, 143, 10
}

IDD_PASSWORD DIALOGEX 0, 0, 252, 98
CAPTION "AIN archive password"
STYLE DS_MODALFRAME | WS_POPUPWINDOW | WS_CAPTION
FONT 8, "MS Shell Dlg", 0, 0, 1
{
    LTEXT "Enter the password for this archive:", -1, 10, 10, 232, 12
    EDITTEXT IDC_PASSWORD, 10, 23, 232, 14, ES_AUTOHSCROLL | ES_PASSWORD
    LTEXT "Repeat password:", IDC_PASSWORD_REPEAT_LABEL, 10, 40, 232, 12
    EDITTEXT IDC_PASSWORD_REPEAT, 10, 54, 232, 14, ES_AUTOHSCROLL | ES_PASSWORD
    DEFPUSHBUTTON "OK", IDOK, 140, 75, 50, 16
    PUSHBUTTON "Cancel", IDCANCEL, 192, 75, 50, 16
}

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

#ifdef APSTUDIO_INVOKED

1 TEXTINCLUDE
{
    "resource.h\0"
}

2 TEXTINCLUDE
{
    "#define APSTUDIO_HIDDEN_SYMBOLS\r\n"
    "#include <windows.h>\r\n"
    "#include <commctrl.h>\r\n"
    "#include <richedit.h>\r\n"
    "#undef APSTUDIO_HIDDEN_SYMBOLS\r\n"
    "\0"
}

3 TEXTINCLUDE
{
    "\r\n"
    "\0"
}

#endif // def APSTUDIO_INVOKED
#ifndef APSTUDIO_INVOKED

#endif // ndef APSTUDIO_INVOKED
